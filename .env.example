# LangSmith
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=plan2code-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# SiliconFlow (OpenAI 兼容)
OPENAI_API_KEY=your_siliconflow_api_key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
# Eval - LLM-as-judge 评估器（与主模型分离，避免裁判员=运动员偏差）
OPENAI_LLM_AS_JUDGE=Pro/moonshotai/Kimi-K2.6
# Eval - LangSmith dataset 配置（首次 Phase 7-3 Step 4 后生效）
LANGSMITH_DATASET_BAD_CASES=plan2code-bad-cases-v1
LANGSMITH_DATASET_RAG_CASES=plan2code-rag-cases-v1
LANGSMITH_DATASET_TOOL_CASES=plan2code-tool-cases-v1

# Embedding（须与模型输出维度配套，供 Mem0/Qdrant）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_DIMS=1024

# Rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# Redis
REDIS_URL=redis://localhost:6379
# Quota - Token 配额（监控体系 Phase 7-4 Step 1）
QUOTA_DAILY_TOKENS_PER_USER=200000
QUOTA_PER_THREAD=50000
QUOTA_REDIS_KEY_PREFIX=plan2code:quota
# Audit - 内部 API 鉴权（Agent 端回调 backend 写审计日志用）
INTERNAL_API_KEY=change-me-internal-shared-secret
# Audit - Agent 端回调 backend 内部 API 的根 URL
BACKEND_INTERNAL_URL=http://localhost:3000

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# LangGraph API
LANGGRAPH_API_URL=http://localhost:8123

# 前端展示名称（Vite 仅暴露 VITE_ 前缀变量）
VITE_APP_DISPLAY_NAME=Plan2Code
