# LangSmith
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=plan2code-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# SiliconFlow (OpenAI 兼容)
OPENAI_API_KEY=your_siliconflow_api_key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3.2

# Embedding（须与模型输出维度配套，供 Mem0/Qdrant）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_DIMS=1024

# Rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# LangGraph API
LANGGRAPH_API_URL=http://localhost:8123

# 前端展示名称（Vite 仅暴露 VITE_ 前缀变量）
VITE_APP_DISPLAY_NAME=Plan2Code
